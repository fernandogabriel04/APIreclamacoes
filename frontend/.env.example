# Postgres em produção (ex.: postgres://usuario:senha@host:5432/banco?sslmode=require).
# Em desenvolvimento, "pglite:./.data/local" roda um Postgres embutido, sem instalar nada.
DB_URL=pglite:./.data/local

# Chave da Groq (transcrição, correção e classificação)
GROQ_API_KEY=

# Palavra-chave de acesso ao painel e segredo para assinar a sessão
ACCESS_KEY=
AUTH_SECRET=

# Chave que a integração do WhatsApp envia em POST /api/reclamacoes (header X-Api-Key)
WHATSAPP_API_KEY=

# Opcional: hosts permitidos para audio_url, separados por vírgula (recomendado)
# AUDIO_URL_HOSTS=
