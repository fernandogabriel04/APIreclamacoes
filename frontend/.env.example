# URL da API da Ouvidoria usada pelo formulário público (chamada do navegador)
# Ex.: https://sua-api.com/api/reclamacoes
NEXT_PUBLIC_API_URL=http://localhost:5000/api/reclamacoes

# --- Painel de acompanhamento (/painel) ---
# Base da API Python (sem barra no final). Usada só no servidor do Next.
OUVIDORIA_API_URL=http://localhost:5000
# Chave de leitura da API (mesmo valor de ACCESS_KEY no app/.env)
OUVIDORIA_ACCESS_KEY=HAMUDIHAMIDI
# Senha que libera o acesso ao painel
PAINEL_SENHA=troque-esta-senha
