# Banco de dados. Dev: SQLite. Produção: Postgres (Railway/Supabase entregam
# postgres:// ou postgresql:// — o código normaliza para o driver certo).
DB_URL=sqlite:///./local.db
# Exemplo produção:
# DB_URL=postgresql://usuario:senha@host:5432/banco

# Chave que libera a leitura do painel (GET /api/registros)
ACCESS_KEY=troque-esta-chave

# OpenAI — necessária para transcrever e classificar as manifestações de áudio
OPENAI_API_KEY=

# Modelos de IA (opcional — sobrescreve os padrões do código)
# Transcrição: gpt-4o-transcribe (melhor) ou gpt-4o-mini-transcribe (mais barato)
MODELO_TRANSCRICAO=gpt-4o-transcribe
# Classificação/resumo: gpt-4o-mini
MODELO_CLASSIFICACAO=gpt-4o-mini

# CORS: origens do frontend que podem chamar /api/* pelo navegador.
# "*" libera qualquer origem; ou liste separando por vírgula:
# CORS_ORIGINS=https://ouvidoria.jhc.com.br,http://localhost:3000
CORS_ORIGINS=*
